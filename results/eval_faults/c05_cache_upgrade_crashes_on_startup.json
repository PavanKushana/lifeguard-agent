{
  "title": "Cache upgrade crashes on startup",
  "alert": "The shop homepage loads but product searches fail with 'Service unavailable', and the API health check returns 503.",
  "truth": {
    "service": "cache",
    "category": "crash",
    "root_cause": "A deploy upgraded Redis from 7.4 to 7.5; the new version refuses to start because the existing redis.conf uses a removed configuration directive, so the cache container crashes in a restart loop and the API cannot reach it.",
    "fix": "Roll back the cache container to redis:7.4, then verify searches and the API health check recover. Long term: test Redis upgrades in staging with the production config."
