  "title": "Web server OOM kill without restart",
  "alert": "The website is completely unreachable; browsers show 'Connection refused'.",
  "truth": {
    "service": "web",
    "category": "crash",
    "root_cause": "The web container was killed by the OOM killer due to a temporary memory spike, and because it has no restart policy, it remained stopped.",
    "fix": "Restart the web container, then verify the site loads. Long term: add a restart policy to the web container or investigate the memory spike."
  },
