      "all": [
        {
          "check": "container_running",
          "container": "db"
        },
        {
          "check": "image",
          "container": "api",
          "is": "shopapp/api:2.3.1"
        }
      ]
    },
    "stays_fixed": {
      "all": [
        {
          "check": "container_running",
          "container": "db"
        },
        {
          "check": "image",
          "container": "api",
          "is": "shopapp/api:2.3.1"
        }
      ]
    }
  },
