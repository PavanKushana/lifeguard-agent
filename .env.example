NEBIUS_API_KEY=your-token-factory-api-key
TAVILY_API_KEY=your-tavily-api-key

# Optional. Phone alerts: a Telegram bot token from @BotFather. Without it the page hides the Telegram box.
# TELEGRAM_BOT_TOKEN=your-bot-token
# Optional. Your own Telegram chat id (send /myid to the bot): a short note whenever someone uses the demo.
# OWNER_CHAT_ID=123456789
# Only on a public server: its address, so Telegram can call /telegram/webhook.
# Leave it out on a laptop: there the bot fetches its messages itself.
# PUBLIC_URL=https://your-domain.example

# Optional. Testing on a laptop: switch the demo's spending limit off.
# SPENDING_LIMITS=off

# Optional. The spending limit (AI runs = investigations, your own and picked problems):
# LIMIT_VISITOR_PER_HOUR=8
# LIMIT_VISITOR_PER_DAY=25
# LIMIT_TOTAL_PER_HOUR=40
# LIMIT_TOTAL_PER_DAY=100
